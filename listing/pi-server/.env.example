# Copie ce fichier en ".env" et remplis les valeurs avant de démarrer le serveur.

# Clé secrète que l'appli devra fournir pour sauvegarder/restaurer.
# Choisis une chaîne longue et aléatoire (ex: génère-la avec `openssl rand -hex 32`).
API_KEY=change-moi

# Port d'écoute du serveur (4000 par défaut, pas besoin d'y toucher normalement).
PORT=4000
